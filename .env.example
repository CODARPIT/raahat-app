# Cloudinary — from https://console.cloudinary.com (Dashboard → API Keys)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Passcode responders type to open /respond (share it only with your control room)
RESPONDER_PASSCODE=change-me

# "live"  = call Cloudinary AI Vision (enable the AI Vision add-on in Settings → Add-ons)
# "demo"  = deterministic offline triage from the reporter's note (no add-on needed)
# "auto"  = try live, fall back to demo if the add-on isn't enabled  (recommended)
RAAHAT_AI_MODE=auto

# WhatsApp intake (optional) — from https://console.twilio.com
# Webhook: https://<your-site>/api/whatsapp  (Messaging → Try it out → WhatsApp sandbox settings, method POST)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
