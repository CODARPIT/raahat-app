# Cloudinary — from https://console.cloudinary.com (Dashboard → API Keys)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Passcode responders type to open /respond (share it only with your control room)
RESPONDER_PASSCODE=change-me

# "live"  = call Cloudinary AI Vision (enable the AI Vision add-on in Settings → Add-ons)
# "demo"  = deterministic offline triage from the reporter's note (no add-on needed)
# "auto"  = try live, fall back to demo if the add-on isn't enabled  (recommended)
RAAHAT_AI_MODE=auto
# Each AI Vision call is abandoned after this long and the report falls back to rule-based triage
RAAHAT_AI_TIMEOUT_MS=15000

# Public address of the site (link previews; optional)
PUBLIC_BASE_URL=https://raahat-kappa.vercel.app

# Telegram intake (optional, free) — create a bot with @BotFather in Telegram (/newbot)
# After deploying, run `npm run telegram:setup` once to point the bot at https://<your-site>/api/telegram
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
# Any long random string; Telegram sends it back on every update so nobody else can post to the webhook
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string
# The bot's username without @, shown on the home page (e.g. RaahatReportBot)
TELEGRAM_BOT_USERNAME=YourRaahatBot

# Instagram account that posts fact-check cards (optional, without @), shown on the home page
INSTAGRAM_HANDLE=

# WhatsApp intake (optional, Twilio is paid after the trial) — from https://console.twilio.com
# Webhook: https://<your-site>/api/whatsapp  (Messaging → Try it out → WhatsApp sandbox settings, method POST)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# The sandbox join phrase, shown on the landing page so citizens can join (e.g. "join silver-tiger")
TWILIO_SANDBOX_JOIN=join your-sandbox-code
